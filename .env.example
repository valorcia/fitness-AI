# ─────────────────────────────
# Core
# ─────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CoachMe"

# ─────────────────────────────
# Database (Postgres, Supabase or Neon)
# ─────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/pulsecoach?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pulsecoach?schema=public"

# ─────────────────────────────
# Auth.js (NextAuth v5)
# ─────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ─────────────────────────────
# Stripe
# ─────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""

# ─────────────────────────────
# OpenAI
# ─────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL_COACH="gpt-4o-mini"
OPENAI_MODEL_TTS="tts-1"
OPENAI_MODEL_STT="whisper-1"

# ─────────────────────────────
# ElevenLabs (voix coach premium — optionnel)
# ─────────────────────────────
ELEVENLABS_API_KEY=""

# ─────────────────────────────
# HeyGen (avatar photoréaliste full-body du coach)
# Génère un avatar personnalisé full-body par utilisateur via la
# Photo Avatar API. Stocké de manière persistante dans Preference.coachAvatarUrl.
# Token: https://app.heygen.com/settings → API
# ─────────────────────────────
HEYGEN_API_KEY=""

# ─────────────────────────────
# fal.ai (génération d'avatar — alternative HeyGen, ~40× moins cher)
# - Flux Dev pour la génération texte → image
# - PuLID Flux pour la génération photo → image (face-locked)
# Token: https://fal.ai/dashboard/keys
# ─────────────────────────────
FAL_KEY=""

# ─────────────────────────────
# Vercel Blob (stockage durable des photos sources + avatars générés)
# Token: créer un store sur https://vercel.com/dashboard/stores
# ─────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────
# Hedra (vidéo de coach parlant — Phase vidéo, optionnel)
# Token: https://www.hedra.com/app/api-keys
# ─────────────────────────────
HEDRA_API_KEY=""

# ─────────────────────────────
# Pexels videos (gratuit, clé requise — https://www.pexels.com/api/)
# ─────────────────────────────
PEXELS_API_KEY=""

# ─────────────────────────────
# Muscle & Motion (anims anatomiques 3D — optionnel, hors budget mini)
# ─────────────────────────────
MUSCLE_MOTION_API_KEY=""

# ─────────────────────────────
# Appareils connectés (optionnel, activation OAuth provider par provider)
# ─────────────────────────────
TERRA_API_KEY=""
TERRA_DEV_ID=""

GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""

FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""

OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""

WITHINGS_CLIENT_ID=""
WITHINGS_CLIENT_SECRET=""

POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""

STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ─────────────────────────────
# Upstash Redis (rate limit, cache)
# ─────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────
# Observability
# ─────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─────────────────────────────
# Admin / feature flags
# ─────────────────────────────
ADMIN_EMAILS="admin@pulsecoach.ai"
ENABLE_VOICE_COACH="true"
ENABLE_OUTDOOR="true"

# ─────────────────────────────
# Demo / dev — bouton "Connexion démo" affiché par défaut sur /login.
# Mettre "false" pour le désactiver en production publique.
# ─────────────────────────────
NEXT_PUBLIC_DEMO_MODE=""
