# ─────────────────────────────
# Core
# ─────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CoachMe"

# ─────────────────────────────
# Database (Postgres, Supabase or Neon)
# ─────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/pulsecoach?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pulsecoach?schema=public"

# ─────────────────────────────
# Auth.js (NextAuth v5)
# ─────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ─────────────────────────────
# Stripe
# ─────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""

# ─────────────────────────────
# OpenAI
# ─────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL_COACH="gpt-4o-mini"
OPENAI_MODEL_TTS="tts-1"
OPENAI_MODEL_STT="whisper-1"

# ─────────────────────────────
# Upstash Redis (rate limit, cache)
# ─────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────
# Observability
# ─────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─────────────────────────────
# Admin / feature flags
# ─────────────────────────────
ADMIN_EMAILS="admin@pulsecoach.ai"
ENABLE_VOICE_COACH="true"
ENABLE_OUTDOOR="true"
